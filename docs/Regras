<style>/* Cão de Suprimentos — documento de regras. Manual de aplicação, tema claro. */
:root{
  --navy:#0F1276; --navy-deep:#0A0C52; --azul:#2B5CE0; --azul-claro:#6C93F2; --azul-fundo:#E4EAFB;
  --creme:#F1EED5; --papel:#FCFBF1; --papel-2:#F6F3E2; --linha:#DDD8B9; --linha-forte:#C7C199;
  --tinta:#141743; --tinta-2:#5D6189; --tinta-3:#8A8DAA;
  --vermelho:#BC3122; --verm-fundo:#F8E6E0; --verm-linha:#E6BCAF;
  --ambar:#96620A; --ambar-fundo:#F9F1DC; --ambar-linha:#DFCE9C;
  --verde:#15624A; --verde-fundo:#E3EFE3; --verde-linha:#B4CFB8;
  --f-display:'Archivo','Archivo Black','Arial Black',sans-serif;
  --f-body:'Poppins',system-ui,-apple-system,Segoe UI,sans-serif;
  --f-mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
*{box-sizing:border-box}
body{margin:0;background:var(--creme);color:var(--tinta);font-family:var(--f-body);
  font-size:14.5px;line-height:1.6;-webkit-font-smoothing:antialiased}
h1,h2,h3,h4,p,ul,figure{margin:0}
code{font-family:var(--f-mono);font-size:.9em;background:var(--papel-2);
  border:1px solid var(--linha);border-radius:5px;padding:1px 5px}
b{font-weight:600}
.disp{font-family:var(--f-display);font-variation-settings:'wdth' 125,'wght' 900;font-weight:900;
  letter-spacing:-.012em;line-height:.94}
.od{--cap-o:.712em;--asp:1.303;display:inline-block;height:var(--cap-o);
  width:calc(var(--cap-o) * var(--asp));vertical-align:baseline;transform:translateY(.013em)}
.od svg{display:block;width:100%;height:100%;fill:currentColor}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
.cao{position:relative;display:block;height:var(--h);width:calc(var(--h) * var(--r));flex:none}
.cao i{position:absolute;inset:0;display:block;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;
  -webkit-mask-size:100% 100%;mask-size:100% 100%}

/* ---- capa ---- */
.topo{background:var(--navy);border-bottom:5px solid var(--azul)}
.topo .in{max-width:940px;margin:0 auto;padding:34px 22px 30px;display:flex;gap:26px;
  align-items:flex-end;justify-content:space-between}
.topo .tx{flex:1;min-width:0}
.eb{font-size:9.6px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--azul-claro)}
.topo h1{font-size:clamp(28px,5.6vw,50px);color:var(--creme);margin-top:8px}
.sub{color:#AEB7EA;font-size:13px;margin-top:12px;max-width:58ch;line-height:1.55}
.meta{display:flex;gap:18px;flex-wrap:wrap;margin-top:16px;font-size:11.6px;color:#8E97D6}
.meta b{color:var(--creme);font-weight:600;font-variant-numeric:tabular-nums}
.meta .d b{color:#F09A8C}
@media (max-width:820px){.topo .cao{display:none}}

.wrap{max-width:940px;margin:0 auto;padding:0 22px 70px}

/* ---- índice ---- */
.indice{margin-top:30px;background:var(--papel);border:1px solid var(--linha);
  border-radius:12px;padding:18px 20px 16px}
.indice h2{font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--tinta-3);
  font-weight:600;margin-bottom:12px}
.grade{display:grid;grid-template-columns:repeat(auto-fit,minmax(252px,1fr));gap:2px 16px}
.sm{display:flex;gap:9px;align-items:baseline;text-decoration:none;color:var(--tinta-2);
  font-size:12.6px;padding:4px 7px;border-radius:6px;border-left:3px solid transparent}
.sm:hover{background:var(--papel-2);color:var(--navy)}
.sm .n{font-variant-numeric:tabular-nums;font-size:10.4px;color:var(--tinta-3);font-weight:600}
.sm.t-green{border-left-color:var(--verde-linha)}
.sm.t-amber{border-left-color:var(--ambar-linha)}
.sm.t-red{border-left-color:var(--vermelho);color:var(--vermelho);font-weight:500}
.leg{margin-top:12px;font-size:11px;color:var(--tinta-3)}
.sw{display:inline-block;width:9px;height:9px;border-radius:2px;vertical-align:0;margin-right:5px}
.sw.g{background:var(--verde-linha)} .sw.a{background:var(--ambar-linha)} .sw.v{background:var(--vermelho)}

/* ---- a régua resumida ---- */
.comofunciona{margin-top:32px}
.nota{font-size:13.4px;color:var(--tinta-2);margin-top:14px;
  background:var(--azul-fundo);border:1px solid var(--azul);border-radius:10px;padding:11px 15px}
.nota b{color:var(--navy)}
.nota2{font-size:13.6px;color:var(--tinta-2);margin-top:14px;max-width:70ch;line-height:1.62}
.nota2 b{color:var(--navy)} .nota2 .rr{color:var(--vermelho)}

h2.grupo{font-family:var(--f-display);font-variation-settings:'wdth' 118,'wght' 900;font-weight:900;
  font-size:clamp(19px,3.2vw,27px);color:var(--navy);line-height:1;margin:44px 0 4px;
  border-top:1px solid var(--linha-forte);padding-top:16px;text-wrap:balance}

/* ---- item de regra ---- */
.rg{background:var(--papel);border:1px solid var(--linha);border-radius:12px;
  padding:16px 19px 13px;margin-top:14px;break-inside:avoid}
.rg.aberta{border-color:var(--verm-linha);background:var(--verm-fundo);border-left:5px solid var(--vermelho)}
.rgh{display:flex;gap:11px;align-items:baseline;flex-wrap:wrap;margin-bottom:9px}
.rgh .n{font-family:var(--f-mono);font-size:11px;color:var(--tinta-3);font-weight:500}
.rgh h3{font-size:15.4px;font-weight:600;color:var(--navy);flex:1;min-width:220px;line-height:1.3}
.rg.aberta .rgh h3{color:var(--vermelho)}
.tag{font-size:10.4px;padding:2px 10px;border-radius:999px;border:1px solid;background:#fff;
  font-weight:500;white-space:nowrap}
.t-green{color:var(--verde);border-color:var(--verde-linha)}
.t-amber{color:var(--ambar);border-color:var(--ambar-linha)}
.t-red{color:var(--vermelho);border-color:var(--verm-linha)}
.rg p{font-size:13.6px;color:var(--tinta-2);line-height:1.6;max-width:74ch}
.rg p b{color:var(--navy)} .rg.aberta p b{color:var(--vermelho)}
.rg .por,.rg .mud{margin-top:10px;font-size:13px}
.rg .por b,.rg .mud b{display:inline;color:var(--navy);font-weight:600}
.rg .mud{border-left:2px solid var(--linha-forte);padding-left:12px;color:var(--tinta-2)}
.rg.aberta .mud{border-left-color:var(--verm-linha)}
pre.f{background:var(--navy-deep);color:#DFE5FF;border-radius:9px;padding:13px 16px;margin:0 0 11px;
  overflow-x:auto;font-family:var(--f-mono);font-size:12px;line-height:1.75;white-space:pre}
pre.f.big{font-size:13px;padding:18px 20px;margin-top:14px}

/* ---- assinatura ---- */
.assin{display:flex;gap:10px;align-items:baseline;margin-top:14px;padding-top:11px;
  border-top:1px dashed var(--linha-forte);font-size:9.6px;letter-spacing:.12em;
  text-transform:uppercase;color:var(--tinta-3);font-weight:600}
.assin i{flex:1;border-bottom:1px solid var(--linha-forte);height:0;margin-bottom:2px}
.assin span:first-child{flex:none}

.fim ul{margin-top:14px;padding-left:19px;display:flex;flex-direction:column;gap:9px;
  font-size:13.6px;color:var(--tinta-2);max-width:74ch;line-height:1.58}
.fim li b{color:var(--navy)}

footer{border-top:1px solid var(--linha-forte);margin-top:52px;padding-top:18px;
  color:var(--tinta-3);font-size:11.6px;display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between}

@media print{
  body{background:#fff;font-size:10.5pt}
  .topo{background:#fff;border-bottom:3px solid var(--navy);color:var(--navy)}
  .topo h1,.sub,.meta b{color:var(--navy)} .sub,.meta{color:var(--tinta-2)}
  .topo .cao{display:none} .indice{display:none}
  .rg{box-shadow:none;page-break-inside:avoid}
  pre.f{background:var(--papel-2);color:var(--navy);border:1px solid var(--linha)}
}
</style>

<header class="topo">
